{
  "name": "@kubohiroya/turbowarp-http-server-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Workers TypeScript generator and TurboWarp extension bridge for turbowarp-http-server.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-http-server-cloudflare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-http-server-cloudflare.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-http-server-cloudflare/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "cloudflare-workers",
    "hono",
    "codegen",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "exports": {
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "import": "./dist/ir.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build"
  },
  "bin": {
    "turbowarp-http-server-cloudflare": "./dist/cli.js"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.39.5",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
