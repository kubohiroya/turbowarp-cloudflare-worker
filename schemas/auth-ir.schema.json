{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubohiroya.github.io/turbowarp-http-server-cloudflare/schemas/auth-ir.schema.json",
  "type": "object",
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "const": "external-oauth-oidc"
    },
    "providers": {
      "items": {
        "enum": [
          "google",
          "microsoft",
          "github"
        ]
      }
    },
    "session": {
      "enum": [
        "signed-cookie",
        "bearer-jwt",
        "cloudflare-access"
      ]
    },
    "protectedRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "onUnauthenticated"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "onUnauthenticated": {
            "enum": [
              "redirect-login",
              "json-401",
              "forbid-403"
            ]
          },
          "auth": {
            "enum": [
              "session",
              "bearer-jwt"
            ]
          },
          "requiredRole": {
            "type": "string",
            "minLength": 1
          },
          "requiredScopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "loginPath": {
      "type": "string",
      "minLength": 1
    },
    "callbackPath": {
      "type": "string",
      "minLength": 1
    },
    "logoutPath": {
      "type": "string",
      "minLength": 1
    },
    "mePath": {
      "type": "string",
      "minLength": 1
    },
    "jwtIssuerEnv": {
      "type": "string",
      "minLength": 1
    },
    "jwtAudienceEnv": {
      "type": "string",
      "minLength": 1
    }
  }
}
