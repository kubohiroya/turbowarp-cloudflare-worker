{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubohiroya.github.io/turbowarp-http-server-cloudflare/schemas/handler-ir.schema.json",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "method",
        "path",
        "responseText"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "responseText": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "responseText"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "responseText": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
