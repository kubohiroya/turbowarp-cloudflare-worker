{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubohiroya.github.io/turbowarp-http-server-cloudflare/schemas/protected-routes.schema.json",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "method",
        "path",
        "onUnauthenticated"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "onUnauthenticated": {
          "enum": [
            "redirect-login",
            "json-401",
            "forbid-403"
          ]
        },
        "auth": {
          "enum": [
            "session",
            "bearer-jwt"
          ]
        },
        "requiredRole": {
          "type": "string",
          "minLength": 1
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "onUnauthenticated"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "onUnauthenticated": {
            "enum": [
              "redirect-login",
              "json-401",
              "forbid-403"
            ]
          },
          "auth": {
            "enum": [
              "session",
              "bearer-jwt"
            ]
          },
          "requiredRole": {
            "type": "string",
            "minLength": 1
          },
          "requiredScopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
